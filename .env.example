# Copy to .env and adjust. Docker Compose reads this; every value is optional.
# The engine settings below only seed the first start (and AUTOSTART) — after
# that /server owns them in state/server.json.

# OpenAI-compatible listen address (host-side)
# (also serves /monitor/ and /server/ at http://127.0.0.1:$LLM_PORT/). The old
# name LLAMA_PORT is still read if LLM_PORT isn't set.
LLM_PORT=8888
WEBUI_PORT=3000
OPENAI_API_KEY=sk-local
# GPU / CPU / RAM sampler behind the /monitor/ telemetry panels (0 = off).
HW_METRICS=1

# /server (switch llama.cpp <-> vLLM, edit flags, download/delete models).
# Set a token so nothing else on your network can change the server; the page
# asks for it once. Empty = no auth (fine if port 8888 isn't reachable).
SERVER_ADMIN_TOKEN=
# Hugging Face token for gated/private repos (downloads and vLLM model pulls).
# Easier: click "HF token" on /server to save one in state/hf_token; a value
# here takes precedence over that.
HF_TOKEN=
# VRAM (GB) /server's auto-tune leaves for the Windows desktop and other GPU
# apps when it sizes the context window.
VRAM_RESERVE_GB=1.5

# ── Start a model with the container ───────────────────────────────────────
# By default the container starts with NO model: /monitor and /server come up
# and you load one from /server (or save a boot default there). Set
# AUTOSTART=1 to start BACKEND with the model below (llama.cpp: TARGET_FILE /
# DRAFT_FILE / MMPROJ_FILE; vllm: VLLM_MODEL) at every container start; it
# overrides a boot default saved on /server.
AUTOSTART=0
BACKEND=llama.cpp
# vLLM: Hugging Face repo id (loaded from the cache in models/)
VLLM_MODEL=
VLLM_MAX_MODEL_LEN=
VLLM_GPU_MEMORY_UTILIZATION=0.88
# Pinned host memory under WSL2 (vLLM disables it there by default). 1 = on.
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# llama.cpp model files under models/ (download them on /server: unsloth/
# Qwen3.8-27B-GGUF for the target + mmproj, incoai/Qwen3.8-27B-DFlash2-GGUF for
# the DFlash 2 draft). The Unsloth Q4_K_M fits a 24 GB RTX 3090 with the draft
# and a 32K KV cache.
TARGET_FILE=Qwen3.8-27B-UD-Q4_K_M.gguf
DRAFT_FILE=Qwen3.8-27B-DFlash2-Q4_K_M.gguf
MMPROJ_FILE=mmproj-F16.gguf
MMPROJ_OFFLOAD=1

# llama.cpp branch, tag (e.g. b7000) or commit SHA. DFlash 2 is in master
# since PR #27342 merged; pin a tag/SHA for reproducible rebuilds.
# /server checks daily for a newer llama.cpp release / vLLM version and shows
# the value to put here; then: docker compose build llm-server && docker compose up -d
LLAMA_CPP_REF=master
# vLLM wheel version installed in the image (must match its CUDA 13.0 torch).
VLLM_VERSION=0.31.0
# GPU architecture(s) llama.cpp compiles for: 86 = RTX 30xx, 89 = RTX 40xx,
# 120 = RTX 50xx. Mixed cards: a semicolon list, e.g. 86;89.
CUDA_ARCH=86
# NCCL for multi-GPU llama.cpp (ON by default; OFF saves ~300 MB on one card).
GGML_CUDA_NCCL=ON
# Parallel nvcc jobs during `docker compose build`; lower if nvcc segfaults/OOMs.
BUILD_JOBS=8

# RTX 3090 serving profile (first-run seed / AUTOSTART; otherwise edit on /server)
CTX_SIZE=32768
SPEC_DRAFT_N_MAX=4
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
N_GPU_LAYERS=99
DRAFT_GPU_LAYERS=99
PARALLEL=1
UBATCH=256
BATCH=2048
THREADS=8

# Qwen3.8 recommended sampling
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20

# Model name reported by /v1/models
ALIAS=Qwen3.8-27B-DFlash2

# llama.cpp's built-in chat page: 0 passes --no-webui (chat goes through Open
# WebUI on WEBUI_PORT), 1 turns it on at http://127.0.0.1:8888/index.html.
# Like the profile above it seeds the first run / AUTOSTART; afterwards it's
# the "Built-in web UI" toggle on /server. (llama.cpp's --webui is an on/off
# switch: `--webui none` is not valid and stops llama-server from starting.)
LLAMA_WEBUI=0
